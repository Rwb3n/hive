# Runtime state — generated by `hive up` / `provision` / `start`, never committed.
# The whole point of provisioning is that these are reproducible from hive.yaml.
rooms/
logs/
shared/
api/hive.db
api/hive.db-shm
api/hive.db-wal
api/*.log
budget.json
egress-allow.json

# Never commit credentials. They are mounted at runtime, never checked in.
**/.credentials.json
.env
*.pem

# OS / editor
.DS_Store
Thumbs.db
*.swp
node_modules/
